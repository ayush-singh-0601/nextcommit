{
  "name": "nextcommit",
  "version": "0.1.0",
  "description": "Give every repository a next step.",
  "license": "MIT",
  "keywords": ["cli", "git", "repository", "codex", "developer-tools"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayush-singh-0601/nextcommit.git"
  },
  "bugs": { "url": "https://github.com/ayush-singh-0601/nextcommit/issues" },
  "homepage": "https://github.com/ayush-singh-0601/nextcommit#readme",
  "type": "module",
  "bin": {
    "nextcommit": "./dist/cli/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/src/index.d.ts",
      "import": "./dist/cli/src/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {},
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  }
}
