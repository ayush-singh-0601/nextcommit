{
  "name": "nextcommit",
  "version": "0.1.4",
  "description": "Give every repository a next step.",
  "license": "MIT",
  "keywords": [
    "cli",
    "git",
    "repository",
    "codex",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayush-singh-0601/nextcommit.git"
  },
  "bugs": {
    "url": "https://github.com/ayush-singh-0601/nextcommit/issues"
  },
  "homepage": "https://github.com/ayush-singh-0601/nextcommit#readme",
  "type": "module",
  "bin": {
    "nextcommit": "dist/cli/src/bin.js",
    "nextcommit-mcp": "dist/cli/src/mcp-bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/src/index.d.ts",
      "import": "./dist/cli/src/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.6",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  }
}
